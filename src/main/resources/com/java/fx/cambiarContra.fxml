<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="592.0" prefWidth="969.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mutualidad.modulo_gerencia.Controllers.CambiarContraController">
   <children>
      <Label layoutX="20.0" layoutY="18.0" text="Cambiar contraseña del usuario" textFill="#39577c">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="42.0" layoutY="68.0" text="Usuario:">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsuario" layoutX="116.0" layoutY="62.0" onAction="#cargarUsuarios" prefHeight="39.0" prefWidth="271.0" promptText="Ingrese el usuario..." />
      <Button fx:id="btnBuscar" layoutX="396.0" layoutY="62.0" mnemonicParsing="false" onAction="#cargarUsuarios" prefHeight="39.0" prefWidth="90.0" style="-fx-background-color: #185754;" text="Buscar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="btnLimpiar" layoutX="497.0" layoutY="62.0" mnemonicParsing="false" onAction="#limpiar" prefHeight="39.0" prefWidth="96.0" style="-fx-background-color: #39577c;" text="Limpiar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Label fx:id="lblNombre" layoutX="33.0" layoutY="143.0" text="Nombre:" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtNombre" editable="false" layoutX="116.0" layoutY="139.0" prefHeight="39.0" prefWidth="550.0" visible="false" />
      <Label fx:id="lblContra" layoutX="12.0" layoutY="192.0" prefHeight="65.0" prefWidth="108.0" text="Nueva contraseña:" visible="false" wrapText="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblConfContra" layoutX="11.0" layoutY="276.0" prefHeight="65.0" prefWidth="108.0" text="Confirmar contraseña:" visible="false" wrapText="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnCambiarContra" layoutX="383.0" layoutY="402.0" mnemonicParsing="false" onAction="#cambiarContraseña" prefHeight="39.0" prefWidth="204.0" style="-fx-background-color: #185754;" text="Cambiar Contraseña" textFill="WHITE" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <PasswordField fx:id="txtContra" layoutX="117.0" layoutY="216.0" prefHeight="39.0" prefWidth="550.0" visible="false" />
      <PasswordField fx:id="txtConfContra" layoutX="120.0" layoutY="298.0" prefHeight="39.0" prefWidth="550.0" visible="false" />
   </children>
</Pane>
