<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="592.0" prefWidth="969.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mutualidad.modulo_gerencia.Controllers.PermisosController">
   <children>
      <TabPane fx:id="tabPadre" prefHeight="592.0" prefWidth="969.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="USUARIO">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="156.0" prefWidth="791.0">
                     <children>
                        <Label layoutX="35.0" layoutY="19.0" text="Cargar Datos de Usuario" textFill="#39577c">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <Label layoutX="35.0" layoutY="81.0" text="Usuario:">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtUsuario" layoutX="113.0" layoutY="75.0" onAction="#cargarUsuarios" prefHeight="39.0" prefWidth="217.0" promptText="Ingrese el usuario..." />
                        <Button fx:id="btnBuscar" layoutX="342.0" layoutY="75.0" mnemonicParsing="false" onAction="#cargarUsuarios" prefHeight="39.0" prefWidth="90.0" style="-fx-background-color: #185754;" text="Buscar" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Button fx:id="btnLimpiar" layoutX="443.0" layoutY="75.0" mnemonicParsing="false" onAction="#limpiar" prefHeight="39.0" prefWidth="96.0" style="-fx-background-color: #39577c;" text="Limpiar" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Label fx:id="lblNombre" layoutX="29.0" layoutY="147.0" text="Nombre:" visible="false">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNombre" layoutX="113.0" layoutY="141.0" prefHeight="39.0" prefWidth="659.0" visible="false" />
                        <Label fx:id="lblRol" layoutX="70.0" layoutY="210.0" text="Rol:" visible="false">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtRol" layoutX="113.0" layoutY="204.0" prefHeight="39.0" prefWidth="330.0" visible="false" />
                        <Label fx:id="lblPuesto" layoutX="42.0" layoutY="275.0" text="Puesto:" visible="false">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtPuesto" layoutX="113.0" layoutY="269.0" prefHeight="39.0" prefWidth="330.0" visible="false" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab fx:id="tabPermisos" onSelectionChanged="#chequeoCambio" text="PERMISOS">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Label layoutX="91.0" layoutY="31.0" text="Módulo:">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cmbModulo" layoutX="173.0" layoutY="25.0" onAction="#cargarDatosTabla" prefHeight="39.0" prefWidth="366.0" />
                        <TableView fx:id="tblPermisos" layoutX="96.0" layoutY="144.0" prefHeight="267.0" prefWidth="766.0">
                          <columns>
                            <TableColumn fx:id="colId" prefWidth="75.0" text="ID" visible="false" />
                            <TableColumn fx:id="colModulo" prefWidth="536.0" text="MÓDULO" />
                              <TableColumn fx:id="colSeleccionar" prefWidth="229.0" text="SELECCIONAR" />
                          </columns>
                        </TableView>
                        <Label layoutX="566.0" layoutY="101.0" text="Buscar:">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtBuscarTabla" alignment="CENTER_RIGHT" layoutX="637.0" layoutY="95.0" onKeyReleased="#buscarPermisos" />
                        <Label fx:id="lblSelecTodos" layoutX="711.0" layoutY="414.0" onMouseClicked="#seleccionarTodos" text="Seleccionar Todos" textFill="#39577c" underline="true" visible="false">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Label>
                        <Button fx:id="btnGuardar" layoutX="390.0" layoutY="453.0" mnemonicParsing="false" onAction="#guardarPermisos" prefHeight="39.0" prefWidth="179.0" style="-fx-background-color: #185754;" text="Guardar Cambios" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Label fx:id="lblDesSelecTodos" layoutX="690.0" layoutY="414.0" onMouseClicked="#seleccionarTodos" text="Deseleccionar Todos" textFill="#39577c" underline="true" visible="false">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Label>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab text="CIERRE CAJEROS">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tblCajeros" layoutX="35.0" layoutY="81.0" prefHeight="379.0" prefWidth="891.0">
                          <columns>
                            <TableColumn fx:id="colIdCajero" editable="false" prefWidth="78.0" sortable="false" text="ID" />
                            <TableColumn fx:id="colUsuarioCajero" editable="false" prefWidth="178.0" sortable="false" text="USUARIO" />
                              <TableColumn fx:id="colEmpresa" editable="false" prefWidth="453.0" sortable="false" text="EMPRESA" />
                              <TableColumn fx:id="colPermitirCierre" editable="false" prefWidth="181.0" sortable="false" text="PERMITIR CIERRE" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <Label layoutX="35.0" layoutY="19.0" text="Cargar Datos de Usuario" textFill="#39577c">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</Pane>
