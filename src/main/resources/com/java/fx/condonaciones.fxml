<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="592.0" prefWidth="969.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mutualidad.modulo_gerencia.Controllers.CondonacionesController">

    <children>
        <Label layoutX="20.0" layoutY="18.0" text="Condonaciones de Crédito" textFill="#39577c">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label fx:id="lblNumero" layoutX="42.0" layoutY="68.0" text="Número:">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TextField fx:id="txtNumero" layoutX="127.0" layoutY="62.0" onAction="#cargarSocio" prefHeight="39.0" prefWidth="184.0" promptText="Ingrese el número..." />
        <Button fx:id="btnBuscar" layoutX="319.0" layoutY="62.0" mnemonicParsing="false" onAction="#cargarSocio" prefHeight="39.0" prefWidth="90.0" style="-fx-background-color: #185754;" text="Buscar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Button fx:id="btnLimpiar" layoutX="422.0" layoutY="62.0" mnemonicParsing="false" onAction="#limpiar" prefHeight="39.0" prefWidth="96.0" style="-fx-background-color: #39577c;" text="Limpiar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <ImageView fx:id="imgBusqueda" fitHeight="35.0" fitWidth="52.0" layoutX="533.0" layoutY="62.0" onMouseClicked="#buscarSocioPorNombre" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@/assets/images/icono-busqueda.png" />
            </image>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </ImageView>
        <ComboBox fx:id="cmbEmpresa" layoutX="127.0" layoutY="202.0" onAction="#onChangeCmbEmpresa" prefHeight="39.0" prefWidth="633.0" visible="false" />
        <TableView fx:id="tblCreditos" layoutX="42.0" layoutY="303.0" onMouseClicked="#cargarCuotaConClick" prefHeight="200.0" prefWidth="873.0" scaleShape="false" visible="false">
            <columns>
                <TableColumn fx:id="colFolio" editable="false" prefWidth="117.0" sortable="false" text="FOLIO" />
                <TableColumn fx:id="colMonto" editable="false" prefWidth="191.0" sortable="false" text="MONTO" />
                <TableColumn fx:id="colFechaDesem" editable="false" prefWidth="288.0" sortable="false" text="FECHA DESEMBOLSO" />
                <TableColumn fx:id="colEstado" editable="false" prefWidth="141.0" sortable="false" text="ESTADO" />
                <TableColumn fx:id="colTipo" editable="false" prefWidth="143.0" sortable="false" text="TIPO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label fx:id="lblSeleccionar" layoutX="42.0" layoutY="270.0" text="Seleccionar Crédito" visible="false">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Button fx:id="btnCargarCredito" layoutX="762.0" layoutY="520.0" mnemonicParsing="false" onAction="#mostrarCuotas" prefHeight="39.0" prefWidth="153.0" style="-fx-background-color: #39577c;" text="Cargar Crédito" textFill="WHITE" visible="false">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Label fx:id="lblNombre" layoutX="42.0" layoutY="138.0" text="Nombre:" visible="false">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TextField fx:id="txtNombre" editable="false" layoutX="127.0" layoutY="132.0" prefHeight="39.0" prefWidth="633.0" visible="false" />
      <Label fx:id="lblEmpresa" layoutX="40.0" layoutY="208.0" text="Empresa:" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnImprimir" layoutX="43.0" layoutY="520.0" mnemonicParsing="false" onAction="#imprimirReporte" prefHeight="39.0" prefWidth="184.0" style="-fx-background-color: #39577c;" text="Imprimir Reporte" textFill="WHITE" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
    </children>

</Pane>
