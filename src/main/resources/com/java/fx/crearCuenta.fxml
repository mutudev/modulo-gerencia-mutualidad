<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane prefHeight="592.0" prefWidth="969.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mutualidad.modulo_gerencia.Controllers.CrearCuentaController">
    <children>
        <Label layoutX="20.0" layoutY="18.0" text="Crear Cuenta de Ahorro" textFill="#39577c">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label layoutX="34.0" layoutY="91.0" text="Número:">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TextField fx:id="txtNumero" layoutX="119.0" layoutY="85.0" onAction="#buscarSocio" prefHeight="39.0" prefWidth="184.0" promptText="Ingrese el número..." />
        <Button fx:id="btnBuscar" layoutX="311.0" layoutY="85.0" mnemonicParsing="false" onAction="#buscarSocio" prefHeight="39.0" prefWidth="90.0" style="-fx-background-color: #185754;" text="Buscar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Button fx:id="btnLimpiar" layoutX="414.0" layoutY="85.0" mnemonicParsing="false" onAction="#limpiar" prefHeight="39.0" prefWidth="96.0" style="-fx-background-color: #39577c;" text="Limpiar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <ImageView fx:id="imgBusqueda" fitHeight="35.0" fitWidth="52.0" layoutX="529.0" layoutY="86.0" onMouseClicked="#buscarSocioPorNombre" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@/assets/images/icono-busqueda.png" />
            </image>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
        </ImageView>
      <TextField fx:id="txtNombre" layoutX="119.0" layoutY="155.0" prefHeight="39.0" prefWidth="744.0" visible="false" />
      <Label fx:id="lblNombre" layoutX="34.0" layoutY="161.0" text="Nombre:" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnCrear" layoutX="375.0" layoutY="243.0" mnemonicParsing="false" onAction="#crearCuenta" prefHeight="39.0" prefWidth="220.0" style="-fx-background-color: #185754;" text="Crear Cuenta" textFill="WHITE" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
    </children>
</Pane>
