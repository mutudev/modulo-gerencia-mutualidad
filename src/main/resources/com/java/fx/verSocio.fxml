         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Label fx:id="lblGenero" layoutX="433.0" layoutY="464.0" text="Género:" visible="false">
