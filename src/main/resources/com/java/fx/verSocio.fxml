      <ComboBox fx:id="cmbEstadoCivil" layoutX="522.0" layoutY="384.0" prefHeight="39.0" prefWidth="414.0" promptText="Seleccione un estado civil..." visible="false" visibleRowCount="5" />
      <TextField fx:id="txtTelefono" layoutX="115.0" layoutY="458.0" prefHeight="39.0" prefWidth="299.0" promptText="XXX-XXX-XXXX" visible="false" />

      <Label fx:id="lblFecha" layoutX="497.0" layoutY="183.0" prefHeight="27.0" prefWidth="184.0" text="Fecha de nacimiento:" visible="false" wrapText="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblApellidoP" layoutX="497.0" layoutY="123.0" text="Apellido Paterno:" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblApellidoM" layoutX="24.0" layoutY="183.0" text="Apellido Materno:" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblCurp" layoutX="24.0" layoutY="248.0" text="CURP:" visible="false">
         <font>
            <Font name="System Bold" size="18.0" />
