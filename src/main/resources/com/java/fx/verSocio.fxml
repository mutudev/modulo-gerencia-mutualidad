      </Label>
      <TextField fx:id="txtNombre" layoutX="127.0" layoutY="117.0" prefHeight="39.0" prefWidth="361.0" visible="false" />
      <TextField fx:id="txtApellidoP" layoutX="652.0" layoutY="117.0" prefHeight="39.0" prefWidth="281.0" visible="false" />
      <TextField fx:id="txtApellidoM" layoutX="185.0" layoutY="177.0" prefHeight="39.0" prefWidth="281.0" visible="false" />
      <DatePicker fx:id="dteNacimiento" layoutX="689.0" layoutY="177.0" prefHeight="39.0" prefWidth="244.0" visible="false" />

      <TextField fx:id="txtCURP" layoutX="85.0" layoutY="242.0" prefHeight="39.0" prefWidth="281.0" promptText="XXXXXXXXXXXXXXXXXX" visible="false" />
      <TextField fx:id="txtRFC" layoutX="419.0" layoutY="242.0" prefHeight="39.0" prefWidth="216.0" promptText="XXXXXXXXXXXXX" visible="false" />
